{
    "files": ["varios_inputs.py"],
    "description": "Exercício de inputs sequenciais",
    "varios_inputs.py": {
        "INPUTS":[
            {
                "input": ["amora", "morango", "cereja"],
                "expected": ["Hmmm, também gosto de amora, morango e cereja!"]
            },
            {
                "input": ["fidelidade", "amor", "pudim"],
                "expected": ["Hmmm, também gosto de fidelidade, amor e pudim!"]
            },
            {
                "input": ["REPITA", "fidelidade", "pudim"],
                "expected": ["fidelidade", "pudim"],
                "info": "REPITA repete os inputs anteriores, sem a palavra REPITA"
            }
        ]
    }
}