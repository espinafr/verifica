{
    "files": ["file1.py", "file2.py"],
    "description": "Exercício de exemplo",
    "file1.py": {
        "CLI": [
            {
                "input": "",
                "expected": "Hello, World!",
                "info": "mostra hello world no console"
            },
            {
                "input": "Théo",
                "expected": "Hello, Théo!",
                "info": "lida com input de nome"
            }
        ],
        "STRUCTURE": {
            "FUNCTIONS": [
                {
                    "name": "my_function",
                    "runs": [
                        {
                            "input": [1, 2],
                            "expected": "3",
                            "info": "soma dois números"
                        }
                    ]
                }
            ],
            "CLASSES": [
                {
                    "name": "RG",
                    "initialized": true,
                    "initializer": {
                        "input": ["Théo", 18],
                        "info": "inicializa a classe"
                    },
                    "methods": [
                        {
                            "name": "idade",
                            "input": [1],
                            "expected": "19",
                            "info": "incrementa a idade em 1",
                            "static": false
                        },
                        {
                            "name": "idade",
                            "input": [-1],
                            "expected": "17",
                            "info": "decrementa a idade em 1",
                            "static": false
                        },
                        {
                            "name": "nome",
                            "input": [],
                            "expected": "Théo",
                            "info": "retorna o nome da pessoa",
                            "static": false
                        }
                    ]
                }
            ]
        },
        "INPUTS": [
            {
                "input": "ola tudo bem",
                "expected": "sim senhor"
            }
        ],
        "SEQUENCE_INPUTS":[
            {
                "input": ["ola", "ola", "ola"],
                "expected": ["ei", "ei", "ei"]
            }
        ]
    },
    "file2.py": {
        "CLI": [
            {
                "input": "python file2.py",
                "expected": "Hello, World!",
                "info": "mostra hello world no console"
            }
        ],
        "CLASS": [
            {
                "name": "MyClass",
                "methods": [
                    {
                        "name": "my_method",
                        "input": [1, 2],
                        "expected": "3",
                        "info": "soma dois números"
                    }
                ]
            }
        ],
        "FUNCTION": [
            {
                "name": "my_function",
                "input": [1, 2],
                "expected": "3",
                "info": "soma dois números"
            }
        ]
    }
